{
  "name": "linkedin-profile-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension — a private note on any LinkedIn profile you visit, keyed by the profile itself. No account, no CRM, no cloud.",
  "scripts": {
    "icons": "node ./scripts/gen-icons.mjs",
    "build": "node ./scripts/build.mjs",
    "build:prod": "node ./scripts/build.mjs --env production",
    "build:watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/selftest.mjs",
    "zip": "node ./scripts/build.mjs --env production && node ./scripts/zip.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
