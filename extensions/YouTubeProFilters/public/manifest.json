{
  "manifest_version": 3,
  "name": "YouTube Pro Filters",
  "version": "1.0.0",
  "description": "Filter YouTube search by views/day, channel size and outlier score. No signup, no API key.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Pro Filters",
    "default_popup": "popup.html"
  }
}
