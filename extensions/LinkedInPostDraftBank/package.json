{
  "name": "linkedin-post-draft-bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension — a live \"see more\" cutoff marker plus a local library of your own LinkedIn drafts, templates and published posts. Local only, no account.",
  "scripts": {
    "icons": "node ./scripts/gen-icons.mjs",
    "build": "node ./scripts/build.mjs",
    "build:prod": "node ./scripts/build.mjs --env production",
    "build:watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/selftest.mjs",
    "zip": "node ./scripts/build.mjs --env production && node ./scripts/zip.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
