{
  "manifest_version": 3,
  "name": "Screen Capture — Full Page Screenshot, Annotate, Blur",
  "short_name": "Screen Capture",
  "description": "Full-page screenshots with annotate and blur. No account, no upload — captures never leave your device.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Screen Capture"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "offscreen"
  ],
  "commands": {
    "capture-full-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Capture full page screenshot"
    }
  }
}
